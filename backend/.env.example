# Copy this file to backend/.env and adjust values as needed.
# app/config.py loads it automatically (via python-dotenv).
# The backend runs fine with NO .env file — these only override defaults.

# Comma-separated list of browser origins allowed to call the API (CORS).
CIVICFIX_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Name reported by GET /health.
# CIVICFIX_SERVICE_NAME=civicfix-backend

# Featherless AI — drives the vision agent (POST /complaints/analyze).
# The app still boots without a key, but AI endpoints return 502 until it
# is set. Get a key at https://featherless.ai
FEATHERLESS_API_KEY=

# Supabase — complaint persistence (SupabaseService). From the Supabase
# dashboard: Project Settings -> API. Run backend/supabase/schema.sql in the
# SQL editor first. The app boots without these; database calls error until
# both are set.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Supabase Storage bucket for complaint photos (StorageService). Created
# automatically by schema.sql; keep the default unless you renamed it.
# SUPABASE_STORAGE_BUCKET=complaint-photos

# Location Agent — the Featherless chat model is the PRIMARY interpreter
# of the reverse-geocoded address into GHMC zone/ward/area/infrastructure.
# Default: ungated Qwen 7B. The built-in address parser is the fallback
# when the model is unset/busy/gated. Set WARD_MODEL= (an empty value) to
# disable AI for this step and use the parser only.
WARD_MODEL=Qwen/Qwen2.5-7B-Instruct

# Routing Agent — chat model that maps an issue category to the responsible
# GHMC department. The default is ungated and fast; leave empty to use the
# built-in keyword rules instead.
# ROUTING_MODEL=Qwen/Qwen2.5-7B-Instruct
ROUTING_MODEL=

# GHMC's official WhatsApp number for grievances (the MyCUREApp channel
# accepts complaints via WhatsApp). Digits only WITH country code. GHMC's
# published WhatsApp grievance number is 8125966586 (sanitation/civic
# issues; launched March 2026) -> 918125966586. When set, saved
# complaints carry a whatsapp_link - a one-tap wa.me deep link pre-filled
# with the grievance - shown on the /report success card and /track page.
# Leave empty to hide the button.
WHATSAPP_NUMBER=
